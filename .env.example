# Copia este archivo como .env y rellena los valores reales.
# El .env NUNCA se sube a git (está en .gitignore): contiene secretos.

# --- Obligatorias: sin estas dos la app no arranca ---
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_base
# Genera una nueva con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# --- Entorno ---
# En producción DEBE ser "production": si no, quedan expuestos /docs y /redoc,
# la cookie de sesión sale sin el flag Secure, y se loguea todo el SQL.
ENVIRONMENT=development
DEBUG=true

# --- Frontend y CORS ---
# Origen exacto del frontend, con https:// y sin barra final.
# Varios separados por coma.
CORS_ORIGINS=http://localhost:8080
# Se usa para armar los enlaces de los correos (ej. restablecer contraseña).
FRONTEND_URL=http://localhost:8080

# --- Sesiones ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15

# --- Google Sign-In (opcional) ---
# Client ID del proyecto en Google Cloud Console. Sin esto, POST /auth/google
# rechaza todo.
GOOGLE_CLIENT_ID=

# --- Correo transaccional (opcional) ---
# API de Resend. Sin la key, los correos se omiten con un aviso en el log en
# vez de fallar. No se usa SMTP: Render bloquea el puerto saliente.
RESEND_API_KEY=
EMAIL_FROM_EMAIL=no-reply@localhost
EMAIL_FROM_NAME=OrdersCode

# --- WhatsApp Cloud API (opcional) ---
# Sin el token, el envío de la ficha técnica se omite con aviso en el log.
# WHATSAPP_PHONE_NUMBER_ID es el ID interno del número, NO el número.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Nombre exacto de una plantilla YA APROBADA por Meta, con header de tipo
# documento y sin variables en el cuerpo.
WHATSAPP_TEMPLATE_NAME=
# Debe coincidir exacto con el idioma de la plantilla aprobada (es, es_ES...).
WHATSAPP_TEMPLATE_LANGUAGE=es
# Se antepone a los teléfonos que no traen código de país. 57 = Colombia.
WHATSAPP_DEFAULT_COUNTRY_CODE=57
